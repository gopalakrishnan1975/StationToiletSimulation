  "info": {
    "title": "Station Sanitation Data API",
    "version": "6.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health"
      }
    },
    "/v1/data/train-calls": {
      "get": {
        "operationId": "get_calls_v1_data_train_calls_get",
        "parameters": [
          {
            "in": "query",
            "name": "station",
            "required": true,
            "schema": {
              "pattern": "^[A-Z0-9]{1,12}$",
              "title": "Station",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "platform",
            "required": true,
            "schema": {
              "maxLength": 12,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9 -]+$",
              "title": "Platform",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "service_date",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Service Date",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Calls"
      }
    }
  }
